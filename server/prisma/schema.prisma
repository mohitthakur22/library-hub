generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  password      String?
  name          String
  phone         String
  collegeId     String?
  photo         String?
  role          String   @default("STUDENT")
  googleId      String?  @unique
  isBlocked     Boolean  @default(false)
  otp           String?
  otpExpires    DateTime?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]  @relation("UserSubscriptions")
  bookings      Booking[]       @relation("UserBookings")
  payments      Payment[]       @relation("UserPayments")
  checkIns      CheckIn[]       @relation("UserCheckIns")
  notifications Notification[]  @relation("UserNotifications")
  issues        Issue[]         @relation("UserIssues")
  assignedSeats Seat[]          @relation("SeatAssignee")
}

model Seat {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  number        String   @unique
  row           Int
  col           Int
  status        String   @default("AVAILABLE")
  assignedToId  String?  @db.ObjectId
  assignedTo    User?    @relation("SeatAssignee", fields: [assignedToId], references: [id])

  subscriptions Subscription[]  @relation("SeatSubscriptions")
  bookings      Booking[]       @relation("SeatBookings")
}

model Plan {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          String
  price         Float
  durationDays  Int
  description   String?
  features      String?

  subscriptions Subscription[]  @relation("PlanSubscriptions")

  @@index([type])
}

model Subscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation("UserSubscriptions", fields: [userId], references: [id])
  planId    String   @db.ObjectId
  plan      Plan     @relation("PlanSubscriptions", fields: [planId], references: [id])
  seatId    String?  @db.ObjectId
  seat      Seat?    @relation("SeatSubscriptions", fields: [seatId], references: [id])
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE")

  payments Payment[]  @relation("SubscriptionPayments")
  bookings Booking[]  @relation("SubscriptionBookings")

  @@index([userId])
  @@index([planId])
  @@index([seatId])
}

model Booking {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation("UserBookings", fields: [userId], references: [id])
  seatId         String   @db.ObjectId
  seat           Seat     @relation("SeatBookings", fields: [seatId], references: [id])
  subscriptionId String?  @db.ObjectId
  subscription   Subscription? @relation("SubscriptionBookings", fields: [subscriptionId], references: [id])
  date           DateTime
  status         String   @default("CONFIRMED")
  type           String
  createdAt      DateTime @default(now())

  @@index([seatId, date])
  @@index([userId])
}

model Payment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation("UserPayments", fields: [userId], references: [id])
  subscriptionId String?  @db.ObjectId
  subscription   Subscription? @relation("SubscriptionPayments", fields: [subscriptionId], references: [id])
  amount         Float
  status         String   @default("PENDING")
  dueDate        DateTime
  paidAt         DateTime?
  invoiceNumber  String   @unique
  paymentMethod  String?
  externalId     String?
  createdAt      DateTime @default(now())

  @@index([userId])
}

model CheckIn {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation("UserCheckIns", fields: [userId], references: [id])
  seatId    String?  @db.ObjectId
  checkedAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation("UserNotifications", fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  broadcast Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Issue {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation("UserIssues", fields: [userId], references: [id])
  subject     String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  @@index([userId])
}

model BookingConflict {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  seatId     String   @db.ObjectId
  seatNumber String
  userId1    String   @db.ObjectId
  userId2    String   @db.ObjectId
  userName1  String
  userName2  String
  date       DateTime
  resolved   Boolean  @default(false)
  resolvedBy String?  @db.ObjectId
  resolution String?
  createdAt  DateTime @default(now())

  @@index([seatId, date])
}
